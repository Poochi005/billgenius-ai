# Optional - the app works fully WITHOUT a key (built-in local AI simulation).
# Get a key at https://aistudio.google.com/apikey and copy this file to .env.local
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# Optional: port (default 3000)
# PORT=3000
